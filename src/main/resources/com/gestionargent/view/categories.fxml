<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="scroll-transparent"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestionargent.controller.CategoriesController">
    <VBox spacing="20" styleClass="page-dashboard">
        <padding>
            <Insets top="28" right="32" bottom="28" left="32"/>
        </padding>

        <Label text="Catégories" styleClass="titre-page"/>

        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="carte">
            <Label text="Nouvelle catégorie :" styleClass="label-champ"/>
            <TextField fx:id="champNom" promptText="Nom de la catégorie" prefWidth="200"/>
            <ComboBox fx:id="champType" prefWidth="140"/>
            <Button text="Ajouter" onAction="#ajouterCategorie" styleClass="bouton-principal"/>
            <Label fx:id="labelErreur" styleClass="texte-erreur" wrapText="true"/>
        </HBox>

        <HBox spacing="24">
            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="carte">
                <Label text="Dépenses" styleClass="titre-section"/>
                <VBox fx:id="listeDepenses" spacing="4"/>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="carte">
                <Label text="Revenus" styleClass="titre-section"/>
                <VBox fx:id="listeRevenus" spacing="4"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
