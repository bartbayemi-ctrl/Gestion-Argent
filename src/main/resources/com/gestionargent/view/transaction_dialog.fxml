<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="conteneur-dialogue"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gestionargent.controller.TransactionDialogController">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Type" styleClass="label-champ"/>
    <HBox spacing="8">
        <ToggleButton fx:id="boutonDepense" text="Dépense" styleClass="toggle-type" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <ToggleButton fx:id="boutonRevenu" text="Revenu" styleClass="toggle-type" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>

    <Label text="Description" styleClass="label-champ"/>
    <TextField fx:id="champDescription" promptText="Ex : Supermarché Carrefour"/>

    <Label text="Montant (€)" styleClass="label-champ"/>
    <TextField fx:id="champMontant" promptText="Ex : 45.90"/>

    <Label text="Date" styleClass="label-champ"/>
    <DatePicker fx:id="champDate" maxWidth="Infinity"/>

    <Label text="Catégorie" styleClass="label-champ"/>
    <ComboBox fx:id="champCategorie" maxWidth="Infinity"/>

    <Label fx:id="labelErreur" styleClass="texte-erreur" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#annuler" styleClass="bouton-secondaire"/>
        <Button text="Enregistrer" onAction="#enregistrer" styleClass="bouton-principal"/>
    </HBox>
</VBox>
