<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="page-dashboard"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gestionargent.controller.TransactionsController">
    <padding>
        <Insets top="28" right="32" bottom="28" left="32"/>
    </padding>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Transactions" styleClass="titre-page"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="filtreMois" prefWidth="130"/>
        <ComboBox fx:id="filtreAnnee" prefWidth="90"/>
        <Button text="＋ Nouvelle transaction" onAction="#ouvrirDialogueAjout" styleClass="bouton-principal"/>
    </HBox>

    <TableView fx:id="tableTransactions" VBox.vgrow="ALWAYS" styleClass="table-transactions">
        <columns>
            <TableColumn fx:id="colonneDate" text="Date" prefWidth="100"/>
            <TableColumn fx:id="colonneDescription" text="Description" prefWidth="240"/>
            <TableColumn fx:id="colonneCategorie" text="Catégorie" prefWidth="160"/>
            <TableColumn fx:id="colonneType" text="Type" prefWidth="100"/>
            <TableColumn fx:id="colonneMontant" text="Montant" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="labelTotal" text="Total : 0,00 €" styleClass="titre-section"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Modifier" onAction="#modifierTransactionSelectionnee" styleClass="bouton-secondaire"/>
        <Button text="Supprimer" onAction="#supprimerTransactionSelectionnee" styleClass="bouton-danger"/>
        <Button text="Exporter PDF" onAction="#exporterPdf" styleClass="bouton-secondaire"/>
        <Button text="Exporter Excel" onAction="#exporterExcel" styleClass="bouton-secondaire"/>
    </HBox>
</VBox>
